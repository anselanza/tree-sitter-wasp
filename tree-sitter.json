{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "wasp",
      "camelcase": "Wasp",
      "title": "Wasp",
      "scope": "source.wasp",
      "file-types": ["wasp"],
      "injection-regex": "^wasp$",
      "class-name": "TreeSitterWasp"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "Wasp grammar for tree-sitter",
    "authors": [
      {
        "name": "Stephen Buchanan"
      }
    ],
    "links": {
      "repository": "https://github.com/anselanza/tree-sitter-wasp"
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "java": true,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true,
    "zig": false
  }
}
